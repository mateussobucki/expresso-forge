{
  "name": "expresso-forge",
  "version": "1.1.0",
  "description": "Interactive CLI to scaffold Node.js/Express projects with optional MongoDB, PostgreSQL, JWT auth, Socket.io, Docker, ESLint, and Prettier.",
  "type": "module",
  "bin": {
    "expresso-forge": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [],
  "author": "Mateus Sobucki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateussobucki/expresso-forge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
